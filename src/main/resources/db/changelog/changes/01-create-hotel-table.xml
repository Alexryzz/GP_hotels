<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <changeSet id="1" author="me">
        <createTable tableName="hotel">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>

            <column name="name" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="description" type="VARCHAR(1000)"/>
            <column name="brand" type="VARCHAR(100)"/>

            <!-- Address поля -->
            <column name="house_number" type="VARCHAR(20)"/>
            <column name="street" type="VARCHAR(255)"/>
            <column name="city" type="VARCHAR(100)"/>
            <column name="country" type="VARCHAR(100)"/>
            <column name="post_code" type="VARCHAR(20)"/>

            <!-- Contacts поля -->
            <column name="phone" type="VARCHAR(30)">
                <constraints nullable="false"/>
            </column>
            <column name="email" type="VARCHAR(100)"/>

            <!-- ArrivalTime поля -->
            <column name="check_in" type="TIME">
                <constraints nullable="false"/>
            </column>
            <column name="check_out" type="TIME"/>
        </createTable>
    </changeSet>

</databaseChangeLog>